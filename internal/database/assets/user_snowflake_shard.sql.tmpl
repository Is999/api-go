-- 代码资产：将前台 user 表切换为雪花 ID，并增加 shard_no 取模分片字段。
-- SQL 方言：MySQL 8.0 InnoDB。
-- 调用方：internal/database.DefaultMigrations 通过迁移 runner 执行。
-- 安全边界：未发布版本结构迁移；执行前确认 user 表来自当前基线。
ALTER TABLE `user`
  MODIFY COLUMN `id` bigint NOT NULL COMMENT '雪花ID',
  ADD COLUMN `shard_no` int NOT NULL DEFAULT 0 COMMENT '取模分片' AFTER `id`,
  ADD KEY `idx_user_shard_no_id` (`shard_no`, `id`);

UPDATE `user`
SET `shard_no` = MOD(`id`, 1000)
WHERE `id` > 0;
